{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "vulnerability",
    "severity",
    "technique",
    "evidence"
  ],
  "properties": {
    "vulnerability": {
      "type": "string",
      "description": "Cross-Site Scripting vulnerability"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "technique": {
      "type": "string",
      "enum": [
        "reflected",
        "stored",
        "dom-based",
        "context-analysis",
        "csp-bypass",
        "waf-bypass",
        "mutation-xss"
      ]
    },
    "endpoint": {
      "type": "string",
      "format": "uri"
    },
    "parameter": {
      "type": "string"
    },
    "payload": {
      "type": "string"
    },
    "evidence": {
      "type": "string",
      "description": "Observed evidence of the vulnerability"
    },
    "impact": {
      "type": "string"
    },
    "remediation": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
